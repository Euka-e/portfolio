---
import Layout from "../layouts/Layout.astro";
import Experience from "../components/Experience.astro";
import Presentation from "../components/Presentation.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Header from "../components/Header.astro";
import Technologies from "../components/Technologies.astro";
import Projects from "../components/projects/Projects.astro";
import Achievements from "../components/Achievements.astro";
import AboutMe from "../components/AboutMe.astro";
import Contact from "../components/Contact.astro";
import AITools from "../components/AITools.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette.astro";
---

<Layout
  title="Eric David Diaz - Full Stack Engineer | Portfolio"
  description="Senior full-stack engineer currently building at Bixlabs. Portfolio focused on scalable product delivery, AI-powered workflows, and high-quality engineering execution."
>
  <main>
    <div class="mx-auto flex items-center justify-start gap-x-10 py-2 xl:w-[1120px]" id="start">
      <Header />
    </div>
    <SectionContainer class="pb-20 pt-10 sm:pt-28">
      <SectionContainer>
        <Presentation />
      </SectionContainer>

      <SectionContainer>
        <Experience />
      </SectionContainer>

      <SectionContainer>
        <Achievements />
      </SectionContainer>

      <SectionContainer>
        <Technologies />
      </SectionContainer>

      <SectionContainer>
        <AITools />
      </SectionContainer>

      <SectionContainer>
        <Projects />
      </SectionContainer>

      <SectionContainer>
        <AboutMe />
      </SectionContainer>

      <SectionContainer>
        <Contact />
      </SectionContainer>
    </SectionContainer>

    <SectionContainer class="mt-2">
      <Footer />
    </SectionContainer>

    <CommandPalette />
  </main>
</Layout>
