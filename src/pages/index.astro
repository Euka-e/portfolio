---
import Layout from "../layouts/Layout.astro";
import Experience from "../components/Experience.astro";
import Presentation from "../components/Presentation.astro";
import Pills from "../components/Pills.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Header from "../components/Header.astro";
import Technologies from "../components/Technologies.astro";
import Projects from "../components/projects/Projects.astro";
import Achievements from "../components/Achievements.astro";
import AboutMe from "../components/AboutMe.astro";
import Contact from "../components/Contact.astro";
---

<Layout
  title="Eric Díaz - Full Stack Engineer | Portfolio"
  description="Full Stack Engineer at Continental Venture Capital. Building robust & user-centric web solutions with expertise in React, Node.js, AWS, and team leadership. Specializing in scalable applications and development process optimization."
>
  <main>
    <div
      class="flex justify-start items-center py-3 xl:w-[1120px] mx-auto gap-x-10"
      id="start"
    >
      <Header />
    </div>
    <SectionContainer class="sm:pt-28 pt-10 pb-20">
      <SectionContainer>
        <Presentation />
        <Pills />
      </SectionContainer>

      <SectionContainer >
        <Experience />
      </SectionContainer>

      <SectionContainer>
        <Achievements />
      </SectionContainer>

      <SectionContainer>
        <Technologies />
      </SectionContainer>

      <SectionContainer>
        <Projects />
      </SectionContainer>

      <SectionContainer>
        <AboutMe />
      </SectionContainer>

      <SectionContainer>
        <Contact />
      </SectionContainer>
    </SectionContainer>
    <!-- <SectionContainer>
      <Footer />
    </SectionContainer> -->
  </main>
</Layout>
