---
import ProjectCard from "./ProjectCard.astro";
import projectsArray from "./projects.json";

const projectsEN = projectsArray;
const projectsES = [
  {
    id: 1,
    title: "Plataforma de Workflow de Inversión",
    description: "Trabajo de producto para una plataforma financiera enfocada en mejorar la interacción entre emprendedores e inversores a lo largo del flujo de evaluación e inversión.",
    date: "2024",
    tasks: [
      "Construí features frontend y backend para el ciclo de inversión",
      "Mejoré la claridad de evaluación de proyectos y flujos operativos",
      "Colaboré en calidad de implementación dentro de un entorno de producto real"
    ]
  },
  {
    id: 2,
    title: "Dashboard de Analítica y Performance",
    description: "Trabajo orientado a dashboards para monitorear releases, comportamiento de producto y visibilidad operativa en equipos de alta velocidad.",
    date: "2025",
    tasks: [
      "Estructuré vistas analíticas para insights más claros de producto y despliegues",
      "Mejoré workflows de reporting y visibilidad para toma de decisiones",
      "Puse foco en usabilidad, responsividad y arquitectura frontend mantenible"
    ]
  },
  {
    id: 3,
    title: "Plataforma de Aprendizaje y Mentoría",
    description: "Flujos orientados a training y soporte construidos alrededor de coaching, debugging guidance y enablement de developers.",
    date: "2024",
    tasks: [
      "Creé materiales y recorridos de aprendizaje para temas full-stack",
      "Acompañé workflows de debugging y revisión para developers junior y estudiantes",
      "Conecté product thinking con coaching técnico práctico"
    ]
  }
];
---

<section class="mx-auto w-full pt-20 lg:w-[960px]" id="projects">
  <div class="text-center" data-lang="en" data-animate="fade-up">
    <p class="mb-3 text-sm uppercase tracking-[0.32em] text-accent-cyan">Selected work</p>
    <h2 class="section-title">Projects</h2>
  </div>
  <div class="text-center" data-lang="es" data-animate="fade-up">
    <p class="mb-3 text-sm uppercase tracking-[0.32em] text-accent-cyan">Trabajo seleccionado</p>
    <h2 class="section-title">Proyectos</h2>
  </div>

  <ul class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-lang="en">
    {
      projectsEN.length > 0 ? (
        projectsEN.map((project, index) => (
          <li data-key={project.id} data-animate="fade-up" style={`--stagger-delay:${index * 80}ms;`}>
            <ProjectCard project={project} />
          </li>
        ))
      ) : (
        <p class="text-center text-slate-400">No projects available.</p>
      )
    }
  </ul>

  <ul class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-lang="es">
    {
      projectsES.length > 0 ? (
        projectsES.map((project, index) => (
          <li data-key={project.id} data-animate="fade-up" style={`--stagger-delay:${index * 80}ms;`}>
            <ProjectCard project={project} />
          </li>
        ))
      ) : (
        <p class="text-center text-slate-400">No hay proyectos disponibles.</p>
      )
    }
  </ul>
</section>
