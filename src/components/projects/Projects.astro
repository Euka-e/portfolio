---
import { projects } from "../../data/projects";
---

<div class="py-20 md:py-28">
  <div class="flex items-start gap-4 border-t border-hairline pt-4" data-reveal>
    <span class="font-mono text-[11px] tracking-[0.2em] text-ink-4">05</span>
    <h2 class="font-sans text-h2 font-medium leading-none tracking-[-0.04em] text-ink">
      <span data-lang="es">Proyectos</span>
      <span data-lang="en">Projects</span>
    </h2>
    <p class="ml-auto text-right font-mono text-[11px] uppercase tracking-[0.2em] text-ink-3">
      <span data-lang="es">Trabajo seleccionado</span>
      <span data-lang="en">Selected work</span>
    </p>
  </div>

  <div class="mt-12 border-t border-hairline">
    {
      projects.map((project, index) => (
        <article class="project-row border-b border-hairline" data-reveal>
          <div class="flex items-baseline gap-4">
            <span class="font-mono text-[11px] tracking-[0.2em] text-ink-4">
              P{String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="text-h3-project font-medium tracking-[-0.02em] text-ink">
              <span data-lang="es">{project.title.es}</span>
              <span data-lang="en">{project.title.en}</span>
            </h3>
            <span class="ml-auto font-mono text-[11px] tracking-[0.2em] text-accent">{project.year}</span>
          </div>

          <div class="mt-6 grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
            <p class="max-w-[520px] text-[15px] leading-7 text-ink-2">
              <span data-lang="es">{project.description.es}</span>
              <span data-lang="en">{project.description.en}</span>
            </p>
            <ul class="space-y-2 font-mono text-[12px] leading-5 text-ink-2">
              {
                project.tasks.map((task) => (
                  <li class="grid grid-cols-[18px_1fr] gap-2">
                    <span class="text-accent">/</span>
                    <span>
                      <span data-lang="es">{task.es}</span>
                      <span data-lang="en">{task.en}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</div>

<style>
  .project-row {
    padding: 34px 0;
    transition: background 0.3s ease;
  }

  .project-row:hover {
    background: rgb(255 255 255 / 0.025);
  }
</style>
