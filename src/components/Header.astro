---
import { navItems } from "../data/nav";
---

<header class="fixed inset-x-0 top-0 z-50 h-[58px] border-b border-hairline bg-[rgba(6,6,18,0.86)] font-mono backdrop-blur-[14px]">
  <input id="menu-toggle" type="checkbox" class="sr-only" />
  <div class="relative mx-auto flex h-full w-full max-w-[1280px] items-center px-6">
    <a href="#start" class="whitespace-nowrap text-[12px] uppercase tracking-[0.18em] text-ink">
      Eric David Diaz
    </a>

    <nav
      aria-label="Primary"
      class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-[22px] min-[1150px]:flex"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="whitespace-nowrap border-b border-transparent pb-[3px] text-[11.5px] uppercase tracking-[0.1em] text-ink-3 transition-colors hover:border-accent hover:text-ink"
          >
            <span data-lang="es">{item.es}</span>
            <span data-lang="en">{item.en}</span>
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center">
      <button
        type="button"
        data-share-open
        class="flex h-[34px] items-center justify-center gap-2 border border-hairline px-3 text-[11px] uppercase tracking-[0.14em] text-ink-2 transition-colors hover:border-[rgba(34,211,238,0.5)] hover:bg-[rgba(255,255,255,0.06)] hover:text-ink"
      >
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true" class="size-[13px]">
          <path d="M8 10V1M5 4l3-3 3 3M3 7v7h10V7" />
        </svg>
        <span data-lang="es" class="hidden min-[768px]:inline">Compartir</span>
        <span data-lang="en" class="hidden min-[768px]:inline">Share</span>
      </button>
      <a
        href="/eric-diaz-cv.pdf"
        download="Eric-David-Diaz-CV.pdf"
        class="flex h-[34px] items-center justify-center gap-2 border border-l-0 border-hairline bg-ink px-3 text-[11px] uppercase tracking-[0.14em] text-bg transition-colors hover:bg-accent"
      >
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true" class="size-[13px]">
          <path d="M8 1v9M5 7l3 3 3-3M3 14h10" />
        </svg>
        <span>CV</span>
      </a>
      <button
        type="button"
        data-language-toggle
        aria-label="Cambiar a inglés"
        class="ml-2 flex h-[34px] min-w-[46px] items-center justify-center border border-hairline px-3 text-[11px] uppercase tracking-[0.14em] text-ink transition-colors hover:border-[rgba(34,211,238,0.5)] hover:bg-[rgba(255,255,255,0.06)]"
      >
        <span data-lang="es">EN</span>
        <span data-lang="en">ES</span>
      </button>
      <label
        for="menu-toggle"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
        class="ml-2 flex h-[36px] w-[34px] cursor-pointer items-center justify-center border border-hairline text-ink transition-colors hover:border-[rgba(34,211,238,0.5)] hover:bg-[rgba(255,255,255,0.06)] min-[1150px]:hidden"
      >
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true" class="size-4">
          <path d="M2 4h12M2 8h12M2 12h12" />
        </svg>
      </label>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Principal"
    class="fixed inset-x-0 top-[58px] z-[45] hidden h-[calc(100dvh-58px)] overflow-y-auto bg-[rgba(6,6,18,0.97)] px-6 font-mono backdrop-blur-[10px] min-[1150px]:hidden"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="flex items-center justify-between border-b border-hairline-soft py-[18px] text-[13px] uppercase tracking-[0.1em] text-ink-2 transition-colors hover:text-ink"
        >
          <span data-lang="es">{item.es}</span>
          <span data-lang="en">{item.en}</span>
          <span aria-hidden="true" class="text-ink-4">
            {item.order}
          </span>
        </a>
      ))
    }
  </nav>

  <style>
    #menu-toggle:checked ~ #mobile-menu {
      display: block;
    }
  </style>

  <script>
    const menuToggle = document.getElementById("menu-toggle");

    if (menuToggle instanceof HTMLInputElement) {
      document.querySelectorAll("#mobile-menu a").forEach((link) => {
        link.addEventListener("click", () => {
          menuToggle.checked = false;
        });
      });
    }
  </script>
</header>
