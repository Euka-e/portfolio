---
import { experienceCopy, experienceEntries } from "../data/experience";

const visibleExperiences = experienceEntries.slice(0, 5);
const earlierExperiences = experienceEntries.slice(5);
---

<div>
  <div data-reveal class="flex items-baseline gap-4 border-b border-hairline-strong pb-[14px]">
    <span class="font-mono text-eyebrow uppercase tracking-[0.16em] text-accent">01</span>
    <h2 class="text-h2 text-ink">
      <span data-lang="es">{experienceCopy.title.es}</span>
      <span data-lang="en">{experienceCopy.title.en}</span>
    </h2>
    <span class="ml-auto font-mono text-eyebrow uppercase tracking-[0.16em] text-ink-4">
      <span data-lang="es">{experienceCopy.range.es}</span>
      <span data-lang="en">{experienceCopy.range.en}</span>
    </span>
  </div>

  <div class="relative mt-14">
    <div aria-hidden="true" class="absolute bottom-[6px] left-[5px] top-[6px] w-px bg-hairline"></div>
    <div aria-hidden="true" data-rail class="absolute bottom-[6px] left-[5px] top-[6px] w-px bg-[linear-gradient(180deg,#8b5cf6,#06b6d4)]"></div>

    <div>
      {
        visibleExperiences.map((experience, index) => (
          <article data-reveal class="relative pb-10 pl-9">
            <span
              aria-hidden="true"
              class={`absolute left-0 top-[5px] size-[11px] border bg-bg ${
                index === 0 ? "border-accent" : "border-[rgba(255,255,255,0.3)]"
              }`}
            >
              {index === 0 && <span class="absolute left-[3px] top-[3px] size-[5px] bg-accent"></span>}
            </span>
            <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-eyebrow uppercase tracking-[0.16em] text-ink-3">
              <span class={index === 0 ? "text-accent" : undefined}>
                <span data-lang="es">{experience.es.period}</span>
                <span data-lang="en">{experience.en.period}</span>
              </span>
              <span aria-hidden="true" class="h-[10px] w-px bg-hairline-soft"></span>
              <span>{experience.en.company}</span>
              <span aria-hidden="true" class="h-[10px] w-px bg-hairline-soft"></span>
              <span>
                <span data-lang="es">{experience.es.location}</span>
                <span data-lang="en">{experience.en.location}</span>
              </span>
            </p>
            <h3 class="mt-3 text-h3-role text-ink">
              <span data-lang="es">{experience.es.role}</span>
              <span data-lang="en">{experience.en.role}</span>
            </h3>
            <p class="mt-3 max-w-[720px] text-[15px] leading-[1.7] text-ink-2">
              <span data-lang="es">{experience.es.summary}</span>
              <span data-lang="en">{experience.en.summary}</span>
            </p>
          </article>
        ))
      }
    </div>

    <div data-experience-hidden class="hidden">
      {
        earlierExperiences.map((experience) => (
          <article data-reveal class="relative pb-10 pl-9">
            <span aria-hidden="true" class="absolute left-0 top-[5px] size-[11px] border border-[rgba(255,255,255,0.3)] bg-bg"></span>
            <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-eyebrow uppercase tracking-[0.16em] text-ink-3">
              <span>
                <span data-lang="es">{experience.es.period}</span>
                <span data-lang="en">{experience.en.period}</span>
              </span>
              <span aria-hidden="true" class="h-[10px] w-px bg-hairline-soft"></span>
              <span>{experience.en.company}</span>
              <span aria-hidden="true" class="h-[10px] w-px bg-hairline-soft"></span>
              <span>
                <span data-lang="es">{experience.es.location}</span>
                <span data-lang="en">{experience.en.location}</span>
              </span>
            </p>
            <h3 class="mt-3 text-h3-role text-ink">
              <span data-lang="es">{experience.es.role}</span>
              <span data-lang="en">{experience.en.role}</span>
            </h3>
            <p class="mt-3 max-w-[720px] text-[15px] leading-[1.7] text-ink-2">
              <span data-lang="es">{experience.es.summary}</span>
              <span data-lang="en">{experience.en.summary}</span>
            </p>
          </article>
        ))
      }
    </div>
  </div>

  <button
    type="button"
    data-experience-toggle
    aria-expanded="false"
    class="ml-9 flex h-10 items-center gap-2 border border-hairline px-4 font-mono text-eyebrow uppercase tracking-[0.14em] text-ink-2 transition-colors hover:border-accent hover:text-ink"
  >
    <span aria-hidden="true" data-experience-icon>+</span>
    <span data-experience-more data-lang="es">{experienceCopy.showMore.es}</span>
    <span data-experience-more data-lang="en">{experienceCopy.showMore.en}</span>
    <span data-experience-less data-lang="es" class="hidden">{experienceCopy.showLess.es}</span>
    <span data-experience-less data-lang="en" class="hidden">{experienceCopy.showLess.en}</span>
  </button>

  <script>
    const toggle = document.querySelector("[data-experience-toggle]");
    const hiddenExperiences = document.querySelector("[data-experience-hidden]");

    if (toggle instanceof HTMLButtonElement && hiddenExperiences instanceof HTMLElement) {
      toggle.addEventListener("click", () => {
        const isExpanded = toggle.getAttribute("aria-expanded") === "true";
        const nextExpanded = !isExpanded;

        toggle.setAttribute("aria-expanded", String(nextExpanded));
        hiddenExperiences.classList.toggle("hidden", !nextExpanded);
        toggle.querySelector("[data-experience-icon]")!.textContent = nextExpanded ? "−" : "+";
        toggle.querySelectorAll("[data-experience-more]").forEach((element) => element.classList.toggle("hidden", nextExpanded));
        toggle.querySelectorAll("[data-experience-less]").forEach((element) => element.classList.toggle("hidden", !nextExpanded));
      });
    }
  </script>
</div>
