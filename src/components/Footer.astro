---
import { footerContent } from "../data/contact";
---

<footer class="mx-auto flex w-full flex-wrap items-center gap-x-5 gap-y-4 border-t border-hairline-strong pb-16 pt-[26px] font-mono text-[11px] uppercase tracking-[0.14em]">
  <span class="text-[#f8fafc]">Eric David Diaz</span>
  <span class="text-ink-3">{footerContent.copyright}</span>
  <div class="ml-auto flex items-center gap-5 text-ink-3">
    <a href="#" class="transition-colors hover:text-accent">
      <span data-lang="es">{footerContent.top.es}</span>
      <span data-lang="en">{footerContent.top.en}</span>
    </a>
    <a href="https://github.com/Euka-e" target="_blank" rel="noreferrer" class="transition-colors hover:text-accent">GitHub</a>
    <a href="https://www.linkedin.com/in/eric-diaz-euka/" target="_blank" rel="noreferrer" class="transition-colors hover:text-accent">LinkedIn</a>
  </div>
</footer>
