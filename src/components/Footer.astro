---
const footerCopyEN = {
  experience: "Experience",
  aiTools: "AI Tools",
  projects: "Projects",
  contact: "Contact",
  closing: "(c) 2026 Eric David Diaz. Shipping modern product experiences from Argentina.",
};

const footerCopyES = {
  experience: "Experiencia",
  aiTools: "Herramientas IA",
  projects: "Proyectos",
  contact: "Contacto",
  closing: "(c) 2026 Eric David Diaz. Construyendo experiencias de producto modernas desde Argentina.",
};
---

<footer class="mx-auto w-full px-4 pb-16 pt-1 lg:w-[740px]">
  <div class="glass-card rounded-[22px] px-6 py-7 md:px-8 md:py-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between" data-lang="en">
      <div>
        <p class="text-lg font-semibold text-white">Eric David Diaz</p>
      </div>
      <div class="flex flex-wrap gap-4 text-sm text-slate-300">
        <a href="#experience" class="transition hover:text-accent-cyan">{footerCopyEN.experience}</a>
        <a href="#ai-tools" class="transition hover:text-accent-cyan">{footerCopyEN.aiTools}</a>
        <a href="#projects" class="transition hover:text-accent-cyan">{footerCopyEN.projects}</a>
        <a href="#contact" class="transition hover:text-accent-cyan">{footerCopyEN.contact}</a>
      </div>
    </div>
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between" data-lang="es">
      <div>
        <p class="text-lg font-semibold text-white">Eric David Diaz</p>
      </div>
      <div class="flex flex-wrap gap-4 text-sm text-slate-300">
        <a href="#experience" class="transition hover:text-accent-cyan">{footerCopyES.experience}</a>
        <a href="#ai-tools" class="transition hover:text-accent-cyan">{footerCopyES.aiTools}</a>
        <a href="#projects" class="transition hover:text-accent-cyan">{footerCopyES.projects}</a>
        <a href="#contact" class="transition hover:text-accent-cyan">{footerCopyES.contact}</a>
      </div>
    </div>
    <div class="mt-6 border-t border-white/10 pt-6 text-sm text-slate-500" data-lang="en">
      {footerCopyEN.closing}
    </div>
    <div class="mt-6 border-t border-white/10 pt-6 text-sm text-slate-500" data-lang="es">
      {footerCopyES.closing}
    </div>
  </div>
</footer>
