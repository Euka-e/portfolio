---
import { aboutContent, aboutSections } from "../data/about";
---

<div class="py-20 md:py-28">
  <div class="flex items-start gap-4 border-t border-hairline pt-4" data-reveal>
    <span class="font-mono text-[11px] tracking-[0.2em] text-ink-4">06</span>
    <h2 class="font-sans text-h2 font-medium leading-none tracking-[-0.04em] text-ink">
      <span data-lang="es">{aboutContent.title.es}</span>
      <span data-lang="en">{aboutContent.title.en}</span>
    </h2>
  </div>

  <div class="mt-12 grid gap-12 lg:grid-cols-[1.15fr_0.85fr]">
    <div data-reveal>
      <h3 class="text-[clamp(22px,2.4vw,30px)] font-medium leading-tight tracking-[-0.03em] text-ink">
        <span data-lang="es">{aboutContent.heading.es}</span>
        <span data-lang="en">{aboutContent.heading.en}</span>
      </h3>

      <div class="mt-6 space-y-4">
        {
          aboutContent.paragraphs.map((paragraph) => (
            <p class="max-w-[620px] text-[15px] leading-[1.78] text-ink-2">
              <span data-lang="es">{paragraph.es}</span>
              <span data-lang="en">{paragraph.en}</span>
            </p>
          ))
        }
      </div>

      <div class="mt-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-3">
          <span data-lang="es">{aboutContent.skillsLabel.es}</span>
          <span data-lang="en">{aboutContent.skillsLabel.en}</span>
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            aboutContent.skills.map((skill) => (
              <span class="border border-hairline-strong px-[13px] py-[7px] font-mono text-[11.5px] text-ink-2">
                {skill}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="space-y-8" data-reveal>
      {
        aboutSections.map((section) => (
          <section>
            <div class="flex items-center gap-3">
              <h3 class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent">
                <span data-lang="es">{section.title.es}</span>
                <span data-lang="en">{section.title.en}</span>
              </h3>
              <span class="h-px flex-1 bg-hairline"></span>
            </div>

            <ul class="mt-3">
              {
                section.items.map((item, index) => (
                  <li class="grid grid-cols-[26px_1fr] gap-3 border-b border-hairline-soft py-[13px]">
                    <span class="font-mono text-[11px] tracking-[0.14em] text-ink-4">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="text-[14px] leading-6 text-ink-2">
                      <span data-lang="es">{item.es}</span>
                      <span data-lang="en">{item.en}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</div>
