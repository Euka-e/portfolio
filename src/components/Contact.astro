---
import { contactContent, contactLinks } from "../data/contact";
---

<div class="py-20 md:py-28">
  <div class="flex items-start gap-4 border-t border-hairline pt-4" data-reveal>
    <span class="font-mono text-[11px] tracking-[0.2em] text-ink-4">07</span>
    <h2 class="font-sans text-h2 font-medium leading-none tracking-[-0.04em] text-ink">
      <span data-lang="es">{contactContent.heading.es}</span>
      <span data-lang="en">{contactContent.heading.en}</span>
    </h2>
  </div>

  <div class="mt-14 grid gap-10 lg:grid-cols-2">
    <h3 class="text-[clamp(30px,4.6vw,60px)] font-medium leading-[0.98] tracking-[-0.05em] text-ink" data-reveal="mask">
      <span data-lang="es">{contactContent.statement.es}</span>
      <span data-lang="en">{contactContent.statement.en}</span>
    </h3>

    <div data-reveal>
      <p class="max-w-[480px] text-[15px] leading-7 text-ink-2">
        <span data-lang="es">{contactContent.body.es}</span>
        <span data-lang="en">{contactContent.body.en}</span>
      </p>

      <div class="mt-8 flex flex-wrap">
        <a href="mailto:ericdiazeuka@gmail.com" class="inline-flex h-12 items-center bg-[#f8fafc] px-5 text-[12px] font-medium text-[#060612]">
          <span data-lang="es">{contactContent.hire.es}</span>
          <span data-lang="en">{contactContent.hire.en}</span>
        </a>
        <button type="button" class="inline-flex h-12 items-center border border-l-0 border-hairline px-5 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-2 transition-colors hover:text-accent" data-share-open>
          <span data-lang="es">{contactContent.share.es}</span>
          <span data-lang="en">{contactContent.share.en}</span>
        </button>
      </div>

      <div class="mt-8 font-mono text-[12px]">
        {
          contactLinks.map((link) => (
            <a class="contact-link border-b border-hairline" href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noreferrer" : undefined}>
              <span>{link.label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .contact-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 15px 4px;
    color: #a3a3b8;
    transition: color 0.25s ease, padding-left 0.25s ease;
  }

  .contact-link:hover {
    padding-left: 14px;
    color: #22d3ee;
  }
</style>
