---
import SocialButton from "./SocialButton.astro";
import LinkedInIcon from "../icons/LinkedIn.astro";
import GitHubIcon from "../icons/GitHub.astro";
import MailIcon from "../icons/Mail.astro";
---

<section class="w-full mx-auto lg:w-[740px] pt-20 pb-20" id="contact">
  <h2 class="text-3xl font-bold text-center mb-8">Get In Touch</h2>
  <div class="bg-slate-900 p-8 rounded-lg shadow-md text-center">
    <h3 class="text-xl font-bold text-white mb-4">
      Let's Build Something Amazing Together
    </h3>
    <p class="text-slate-300 mb-8 leading-relaxed">
      I'm always open to discussing new opportunities, collaborating on
      interesting projects, or simply connecting with fellow developers. Whether
      you're looking for a technical lead, a full-stack engineer, or just want
      to chat about the latest in web development, I'd love to hear from you.
    </p>

    <div class="flex justify-center flex-wrap gap-4 mb-8">
      <SocialButton href="mailto:ericdiazeuka@gmail.com">
        <MailIcon class="size-5" />
        Send Email
      </SocialButton>
      <SocialButton href="http://www.linkedin.com/in/eric-diaz-euka">
        <LinkedInIcon class="size-5" />
        LinkedIn
      </SocialButton>
      <SocialButton href="https://github.com/Euka-e">
        <GitHubIcon class="size-5" />
        GitHub
      </SocialButton>
    </div>

    <div class="border-t border-slate-700 pt-6">
      <p class="text-slate-400 text-sm">
        <strong class="text-white">Eric Díaz</strong> • Full Stack Web Developer<br
        />
      </p>
    </div>
  </div>
</section>
