---
import SocialButton from "./SocialButton.astro";
import LinkedInIcon from "../icons/LinkedIn.astro";
import GitHubIcon from "../icons/GitHub.astro";
import MailIcon from "../icons/Mail.astro";

const contactCopyEN = {
  eyebrow: "Let's talk",
  title: "Ready to build something strong?",
  body:
    "I'm open to full-time roles, contract work, and technically ambitious product teams. Based in Argentina and comfortable collaborating across time zones with async-friendly workflows.",
  cta: "Hire me",
  emailLabel: "Email",
};

const contactCopyES = {
  eyebrow: "Hablemos",
  title: "¿Listo para construir algo sólido?",
  body:
    "Estoy abierto a roles full-time, trabajo por contrato y equipos de producto técnicamente ambiciosos. Estoy basado en Argentina y me siento cómodo colaborando entre zonas horarias con workflows async-friendly.",
  cta: "Contrátame",
  emailLabel: "Correo",
};
---

<section class="mx-auto w-full pb-8 pt-20 lg:w-[740px]" id="contact">
  <div
    class="glass-card relative overflow-hidden rounded-[32px] px-8 py-10 text-center md:px-12 md:py-14"
    data-animate="fade-up"
  >
    <div class="pointer-events-none absolute left-1/2 top-0 h-56 w-[130%] -translate-x-1/2 -translate-y-1/3 rounded-full bg-[radial-gradient(circle,rgba(139,92,246,0.3)_0%,rgba(6,182,212,0.12)_38%,transparent_72%)] blur-3xl"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-[radial-gradient(circle_at_bottom,rgba(6,182,212,0.12),transparent_72%)]"></div>
    <div class="relative z-10" data-lang="en">
      <p class="mb-3 text-sm uppercase tracking-[0.32em] text-accent-cyan">{contactCopyEN.eyebrow}</p>
      <h2 class="section-title">{contactCopyEN.title}</h2>
      <p class="section-copy mx-auto mt-5 max-w-2xl">{contactCopyEN.body}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="mailto:ericdiazeuka@gmail.com" class="glow-btn rounded-2xl bg-accent-gradient px-7 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5">
          {contactCopyEN.cta}
        </a>
        <a href="mailto:ericdiazeuka@gmail.com" class="glass-card rounded-2xl px-6 py-3 text-sm font-semibold text-white transition hover:border-white/20">
          ericdiazeuka@gmail.com
        </a>
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <SocialButton href="mailto:ericdiazeuka@gmail.com">
          <MailIcon class="size-5" />
          {contactCopyEN.emailLabel}
        </SocialButton>
        <SocialButton href="https://www.linkedin.com/in/eric-diaz-euka/">
          <LinkedInIcon class="size-5" />
          LinkedIn
        </SocialButton>
        <SocialButton href="https://github.com/Euka-e">
          <GitHubIcon class="size-5" />
          GitHub
        </SocialButton>
      </div>
    </div>
    <div class="relative z-10" data-lang="es">
      <p class="mb-3 text-sm uppercase tracking-[0.32em] text-accent-cyan">{contactCopyES.eyebrow}</p>
      <h2 class="section-title">{contactCopyES.title}</h2>
      <p class="section-copy mx-auto mt-5 max-w-2xl">{contactCopyES.body}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="mailto:ericdiazeuka@gmail.com" class="glow-btn rounded-2xl bg-accent-gradient px-7 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5">
          {contactCopyES.cta}
        </a>
        <a href="mailto:ericdiazeuka@gmail.com" class="glass-card rounded-2xl px-6 py-3 text-sm font-semibold text-white transition hover:border-white/20">
          ericdiazeuka@gmail.com
        </a>
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <SocialButton href="mailto:ericdiazeuka@gmail.com">
          <MailIcon class="size-5" />
          {contactCopyES.emailLabel}
        </SocialButton>
        <SocialButton href="https://www.linkedin.com/in/eric-diaz-euka/">
          <LinkedInIcon class="size-5" />
          LinkedIn
        </SocialButton>
        <SocialButton href="https://github.com/Euka-e">
          <GitHubIcon class="size-5" />
          GitHub
        </SocialButton>
      </div>
    </div>
  </div>
</section>
