<div
  id="command-palette"
  class="fixed inset-0 z-[90] hidden items-start justify-center bg-black/70 px-4 pt-[12vh]"
  aria-hidden="true"
>
  <div class="glass-card w-full max-w-2xl rounded-[28px] border border-white/10 p-4 shadow-glow-lg">
    <div class="mb-3 flex items-center justify-between text-xs text-slate-400">
      <span>eric.portfolio v2.0 - ready</span>
      <span data-lang="en">ESC to close</span>
      <span data-lang="es">ESC para cerrar</span>
    </div>
    <input
      id="command-palette-input"
      type="text"
      data-i18n-placeholder-en="Type a command..."
      data-i18n-placeholder-es="Escribe un comando..."
      placeholder="Type a command..."
      class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-base text-white outline-none transition placeholder:text-slate-500 focus:border-accent-cyan"
    />
    <ul id="command-palette-list" class="mt-4 space-y-2"></ul>
  </div>
</div>

<script>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    const palette = document.getElementById("command-palette");
    const input = document.getElementById("command-palette-input");
    const list = document.getElementById("command-palette-list");

    if (!(palette instanceof HTMLElement) || !(input instanceof HTMLInputElement) || !(list instanceof HTMLElement)) {
      return;
    }

    const commandsByLanguage = {
      en: [
        { label: "Go to Experience", run: () => document.getElementById("experience")?.scrollIntoView({ behavior: "smooth" }) },
        { label: "Go to Projects", run: () => document.getElementById("projects")?.scrollIntoView({ behavior: "smooth" }) },
        { label: "Go to AI Tools", run: () => document.getElementById("ai-tools")?.scrollIntoView({ behavior: "smooth" }) },
        { label: "Go to Contact", run: () => document.getElementById("contact")?.scrollIntoView({ behavior: "smooth" }) },
        { label: "Open GitHub", run: () => window.open("https://github.com/Euka-e", "_blank", "noopener,noreferrer") },
        { label: "Open LinkedIn", run: () => window.open("https://www.linkedin.com/in/eric-diaz-euka/", "_blank", "noopener,noreferrer") },
        { label: "Send Email", run: () => window.open("mailto:ericdiazeuka@gmail.com", "_self") },
      ],
      es: [
        { label: "Ir a Experiencia", run: () => document.getElementById("experience")?.scrollIntoView({ behavior: "smooth" }) },
        { label: "Ir a Proyectos", run: () => document.getElementById("projects")?.scrollIntoView({ behavior: "smooth" }) },
        { label: "Ir a Herramientas IA", run: () => document.getElementById("ai-tools")?.scrollIntoView({ behavior: "smooth" }) },
        { label: "Ir a Contacto", run: () => document.getElementById("contact")?.scrollIntoView({ behavior: "smooth" }) },
        { label: "Abrir GitHub", run: () => window.open("https://github.com/Euka-e", "_blank", "noopener,noreferrer") },
        { label: "Abrir LinkedIn", run: () => window.open("https://www.linkedin.com/in/eric-diaz-euka/", "_blank", "noopener,noreferrer") },
        { label: "Enviar correo", run: () => window.open("mailto:ericdiazeuka@gmail.com", "_self") },
      ],
    };

    const emptyStateByLanguage = {
      en: "No command matches your search.",
      es: "Ningun comando coincide con tu busqueda.",
    };

    let activeIndex = 0;
    let currentLanguage = document.documentElement.dataset.language === "es" ? "es" : "en";
    let filteredCommands = [...commandsByLanguage[currentLanguage]];

    const render = () => {
      list.innerHTML = "";

      if (filteredCommands.length === 0) {
        const emptyState = document.createElement("li");
        emptyState.className = "rounded-2xl border border-white/10 px-4 py-3 text-sm text-slate-400";
        emptyState.textContent = emptyStateByLanguage[currentLanguage];
        list.appendChild(emptyState);
        return;
      }

      filteredCommands.forEach((command, index) => {
        const item = document.createElement("li");
        const button = document.createElement("button");
        button.type = "button";
        button.className = `w-full rounded-2xl border px-4 py-3 text-left text-sm transition ${
          index === activeIndex
            ? "border-accent-cyan bg-white/10 text-white"
            : "border-white/10 bg-white/5 text-slate-300 hover:border-white/20 hover:text-white"
        }`;
        button.textContent = command.label;
        button.addEventListener("click", () => {
          command.run();
          closePalette();
        });
        item.appendChild(button);
        list.appendChild(item);
      });
    };

    const setLanguage = (language) => {
      currentLanguage = language === "es" ? "es" : "en";
      const query = input.value.trim().toLowerCase();
      filteredCommands = commandsByLanguage[currentLanguage].filter((command) =>
        command.label.toLowerCase().includes(query),
      );
      activeIndex = 0;
      render();
    };

    const closePalette = () => {
      palette.classList.add("hidden");
      palette.classList.remove("flex");
      palette.setAttribute("aria-hidden", "true");
      input.value = "";
      filteredCommands = [...commandsByLanguage[currentLanguage]];
      activeIndex = 0;
      render();
    };

    const openPalette = () => {
      palette.classList.remove("hidden");
      palette.classList.add("flex");
      palette.setAttribute("aria-hidden", "false");
      render();
      requestAnimationFrame(() => input.focus());
    };

    document.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        if (palette.classList.contains("hidden")) {
          openPalette();
        } else {
          closePalette();
        }
        return;
      }

      if (palette.classList.contains("hidden")) {
        return;
      }

      if (event.key === "Escape") {
        event.preventDefault();
        closePalette();
      } else if (event.key === "ArrowDown") {
        event.preventDefault();
        activeIndex = (activeIndex + 1) % Math.max(filteredCommands.length, 1);
        render();
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        activeIndex = (activeIndex - 1 + filteredCommands.length) % Math.max(filteredCommands.length, 1);
        render();
      } else if (event.key === "Enter" && filteredCommands[activeIndex]) {
        event.preventDefault();
        filteredCommands[activeIndex].run();
        closePalette();
      }
    });

    input.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      filteredCommands = commandsByLanguage[currentLanguage].filter((command) => command.label.toLowerCase().includes(query));
      activeIndex = 0;
      render();
    });

    palette.addEventListener("click", (event) => {
      if (event.target === palette) {
        closePalette();
      }
    });

    window.addEventListener("portfolio:language-change", (event) => {
      setLanguage(event.detail?.language);
    });

    setLanguage(currentLanguage);
  });
</script>
