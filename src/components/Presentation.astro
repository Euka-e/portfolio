---
import { Image } from "astro:assets";
import { hero } from "../data/hero";
import profile from "../assets/profile-recent.jpg";
import LinkedInIcon from "../icons/LinkedIn.astro";
import GitHubIcon from "../icons/GitHub.astro";
import MailIcon from "../icons/Mail.astro";
---

<div class="grid items-end gap-12 lg:grid-cols-[1.25fr_0.75fr]">
  <div>
    <div data-hero class="flex items-center gap-3 [animation-delay:60ms]">
      <span class="h-px w-7 bg-accent"></span>
      <p class="font-mono text-eyebrow uppercase tracking-[0.24em] text-accent">
        <span data-lang="es">{hero.eyebrow.es}</span>
        <span data-lang="en">{hero.eyebrow.en}</span>
      </p>
    </div>

    <h1 data-hero class="mt-[22px] text-h1 text-ink [animation-delay:140ms]">
      <span data-lang="es" class="block">{hero.greeting.es}</span>
      <span data-lang="en" class="block">{hero.greeting.en}</span>
      <span class="block">Eric David Diaz</span>
    </h1>

    <div data-hero class="mt-[26px] h-px bg-[rgba(255,255,255,0.12)] [animation-delay:220ms]"></div>

    <p data-hero class="mt-4 flex min-h-6 items-center font-mono text-[clamp(13px,1.5vw,16px)] text-ink-2 [animation-delay:260ms]">
      <span
        data-typewriter
        data-phrases-es={hero.phrases.es.join("|")}
        data-phrases-en={hero.phrases.en.join("|")}
      ></span>
      <span aria-hidden="true" class="ml-2 inline-block h-4 w-[9px] bg-accent [animation:caret_1.05s_steps(1)_infinite] motion-reduce:[animation:none]"></span>
    </p>

    <p data-hero class="mt-6 max-w-[560px] text-body-hero text-ink-2 [animation-delay:320ms]">
      <span data-lang="es">{hero.tagline.es}</span>
      <span data-lang="en">{hero.tagline.en}</span>
    </p>

    <div data-hero class="mt-8 flex flex-wrap [animation-delay:380ms]">
      <a href="#contact" class="flex h-[46px] items-center bg-ink px-6 font-mono text-btn uppercase tracking-[0.14em] text-bg transition-colors hover:bg-accent">
        <span data-lang="es">{hero.primaryCta.es} →</span>
        <span data-lang="en">{hero.primaryCta.en} →</span>
      </a>
      <a href="#projects" class="flex h-[46px] items-center border border-l-0 border-hairline px-6 font-mono text-btn uppercase tracking-[0.14em] text-ink transition-colors hover:border-accent hover:text-accent">
        <span data-lang="es">{hero.secondaryCta.es} ↓</span>
        <span data-lang="en">{hero.secondaryCta.en} ↓</span>
      </a>
    </div>

    <div data-hero class="mt-8 flex flex-wrap gap-5 [animation-delay:440ms]">
      <a href="https://www.linkedin.com/in/eric-diaz-euka/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 border-b border-hairline-strong pb-[3px] font-mono text-[11.5px] uppercase tracking-[0.1em] text-ink-2 transition-colors hover:border-accent hover:text-ink">
        <LinkedInIcon class="size-[13px]" />
        LinkedIn
      </a>
      <a href="https://github.com/Euka-e" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 border-b border-hairline-strong pb-[3px] font-mono text-[11.5px] uppercase tracking-[0.1em] text-ink-2 transition-colors hover:border-accent hover:text-ink">
        <GitHubIcon class="size-[13px]" />
        GitHub
      </a>
      <a href="mailto:ericdiazeuka@gmail.com" class="flex items-center gap-2 border-b border-hairline-strong pb-[3px] font-mono text-[11.5px] uppercase tracking-[0.1em] text-ink-2 transition-colors hover:border-accent hover:text-ink">
        <MailIcon class="size-[13px]" />
        <span data-lang="es">{hero.mailLabel.es}</span>
        <span data-lang="en">{hero.mailLabel.en}</span>
      </a>
    </div>
  </div>

  <figure data-hero class="mx-auto w-full max-w-[440px] border border-[rgba(255,255,255,0.12)] p-[10px] [animation-delay:500ms]">
    <Image
      src={profile}
      alt="Eric David Diaz, full-stack engineer"
      widths={[360, 480, 720]}
      sizes="(min-width: 1024px) 30vw, 90vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-[4/5] w-full object-cover object-top grayscale-[0.15] contrast-[1.04]"
    />
    <figcaption class="mt-[10px]">
      <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 font-mono text-[10.5px] uppercase tracking-[0.1em] text-ink-3">
        {
          hero.figure.map((item) => (
            <div class="contents">
              <dt class="text-accent">{item.label}</dt>
              <dd>
                <span data-lang="es">{item.es}</span>
                <span data-lang="en">{item.en}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </figcaption>
  </figure>
</div>
