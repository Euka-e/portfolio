---
import { achievements, achievementsCopy } from "../data/achievements";
---

<div>
  <div data-reveal class="flex items-baseline gap-4 border-b border-hairline-strong pb-[14px]">
    <span class="font-mono text-eyebrow uppercase tracking-[0.16em] text-accent">02</span>
    <h2 class="text-h2 text-ink">
      <span data-lang="es">{achievementsCopy.title.es}</span>
      <span data-lang="en">{achievementsCopy.title.en}</span>
    </h2>
  </div>

  <div class="mt-14 grid grid-cols-1 gap-px bg-hairline md:grid-cols-2 lg:grid-cols-4">
    {
      achievements.map((achievement) => (
        <article data-reveal class="bg-bg px-[26px] pb-[30px] pt-7">
          <p
            data-counter={achievement.metric}
            data-counter-suffix={achievement.suffix}
            class="text-metric tabular-nums text-ink"
          >
            0{achievement.suffix}
          </p>
          <h3 class="mt-[18px] font-mono text-[11.5px] uppercase tracking-[0.16em] text-accent">
            <span data-lang="es">{achievement.es.label}</span>
            <span data-lang="en">{achievement.en.label}</span>
          </h3>
          <p class="mt-3 text-sm leading-[1.65] text-ink-2">
            <span data-lang="es">{achievement.es.description}</span>
            <span data-lang="en">{achievement.en.description}</span>
          </p>
        </article>
      ))
    }
  </div>
</div>
