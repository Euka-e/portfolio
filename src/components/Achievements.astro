---
const achievementsEN = [
  {
    metric: 40,
    suffix: "%",
    label: "Deployment reduction",
    description: "Reduced deployment time through workflow automation and cleaner release pipelines.",
  },
  {
    metric: 60,
    suffix: "%",
    label: "Faster product delivery",
    description: "Cut delivery time for quality product work by moving from fully manual implementation to AI-assisted development workflows.",
  },
  {
    metric: 25,
    suffix: "%",
    label: "UX engagement lift",
    description: "Improved engagement through better component systems, interaction polish, and usability fixes.",
  },
  {
    metric: 50,
    suffix: "+",
    label: "Students mentored",
    description: "Coached developers and students on debugging, delivery habits, and full-stack implementation.",
  },
];

const achievementsES = [
  {
    metric: 40,
    suffix: "%",
    label: "Reducción de despliegues",
    description: "Reduje tiempos de despliegue mediante automatización de workflows y pipelines de release más limpios.",
  },
  {
    metric: 60,
    suffix: "%",
    label: "Entrega de producto más rápida",
    description: "Recorté tiempos de entrega de trabajo de calidad al pasar de una implementación totalmente manual a workflows de desarrollo asistidos por IA.",
  },
  {
    metric: 25,
    suffix: "%",
    label: "Mejora en engagement UX",
    description: "Mejoré el engagement con mejores sistemas de componentes, más pulido de interacciones y correcciones de usabilidad.",
  },
  {
    metric: 50,
    suffix: "+",
    label: "Estudiantes guiados",
    description: "Acompañé a developers y estudiantes en debugging, hábitos de entrega e implementación full-stack.",
  },
];
---

<section class="mx-auto w-full pt-20 lg:w-[740px]" id="achievements">
  <div class="text-center" data-lang="en" data-animate="fade-up">
    <p class="mb-3 text-sm uppercase tracking-[0.32em] text-accent-cyan">Impact</p>
    <h2 class="section-title">Key Achievements</h2>
  </div>
  <div class="text-center" data-lang="es" data-animate="fade-up">
    <p class="mb-3 text-sm uppercase tracking-[0.32em] text-accent-cyan">Impacto</p>
    <h2 class="section-title">Logros Clave</h2>
  </div>

  <div class="mt-10 grid gap-4 md:grid-cols-2" data-lang="en">
    {
      achievementsEN.map((achievement, index) => (
        <article
          class="glass-card spotlight-card rounded-[24px] p-6 transition duration-300 hover:border-accent-purple/40"
          data-animate="fade-up"
          style={`--stagger-delay:${index * 70}ms;`}
        >
          <p class="text-4xl font-bold text-white sm:text-5xl" data-counter={achievement.metric} data-counter-suffix={achievement.suffix}>
            0{achievement.suffix}
          </p>
          <h3 class="mt-4 text-lg font-semibold text-white">{achievement.label}</h3>
          <p class="mt-3 text-sm leading-7 text-slate-300">{achievement.description}</p>
        </article>
      ))
    }
  </div>

  <div class="mt-10 grid gap-4 md:grid-cols-2" data-lang="es">
    {
      achievementsES.map((achievement, index) => (
        <article
          class="glass-card spotlight-card rounded-[24px] p-6 transition duration-300 hover:border-accent-purple/40"
          data-animate="fade-up"
          style={`--stagger-delay:${index * 70}ms;`}
        >
          <p class="text-4xl font-bold text-white sm:text-5xl" data-counter={achievement.metric} data-counter-suffix={achievement.suffix}>
            0{achievement.suffix}
          </p>
          <h3 class="mt-4 text-lg font-semibold text-white">{achievement.label}</h3>
          <p class="mt-3 text-sm leading-7 text-slate-300">{achievement.description}</p>
        </article>
      ))
    }
  </div>
</section>
