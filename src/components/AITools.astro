---
import { aiTools, aiToolsContent } from "../data/ai-tools";
import { aiIcons } from "../icons/ai";
---

<div class="py-20 md:py-28">
  <div class="border-t border-hairline pt-4" data-reveal>
    <div class="flex items-start gap-4">
      <span class="font-mono text-[11px] tracking-[0.2em] text-ink-4">04</span>
      <h2 class="font-sans text-h2 font-medium leading-none tracking-[-0.04em] text-ink">
        <span data-lang="es">{aiToolsContent.title.es}</span>
        <span data-lang="en">{aiToolsContent.title.en}</span>
      </h2>
    </div>
    <p class="mt-6 max-w-[620px] text-[15px] leading-7 text-ink-2">
      <span data-lang="es">{aiToolsContent.intro.es}</span>
      <span data-lang="en">{aiToolsContent.intro.en}</span>
    </p>
  </div>

  <div class="mt-12 border-t border-hairline">
    {
      aiTools.map((tool) => {
        const Icon = aiIcons[tool.icon];

        return (
          <article class="ai-tool-row border-b border-hairline" data-reveal>
            <Icon class="ai-tool-icon text-accent" />
            <div>
              <h3 class="text-[18px] font-medium leading-tight text-ink">{tool.name}</h3>
              <p class="mt-2 text-[14.5px] leading-6 text-ink-2">
                <span data-lang="es">{tool.description.es}</span>
                <span data-lang="en">{tool.description.en}</span>
              </p>
            </div>
          </article>
        );
      })
    }
  </div>

  <p class="mt-10 max-w-[780px] border-l border-accent pl-5 text-[15px] leading-7 text-ink-2" data-reveal>
    <span data-lang="es">{aiToolsContent.closing.es}</span>
    <span data-lang="en">{aiToolsContent.closing.en}</span>
  </p>
</div>

<style>
  .ai-tool-row {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    align-items: start;
    column-gap: 20px;
    padding: 22px 8px;
    transition: background 0.25s ease, padding-left 0.25s ease;
  }

  .ai-tool-row:hover {
    padding-left: 18px;
    background: rgb(255 255 255 / 0.035);
  }

  :global(.ai-tool-icon) {
    width: 26px;
    height: 26px;
  }
</style>
