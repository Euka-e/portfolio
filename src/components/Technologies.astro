---
import { technologyGroups } from "../data/technologies";
import { techIcons } from "../icons/technologies";
---

<div class="py-20 md:py-28">
  <div class="mb-12 flex items-start gap-4 border-t border-hairline pt-4" data-reveal>
    <span class="font-mono text-[11px] tracking-[0.2em] text-ink-4">03</span>
    <h2 class="font-sans text-h2 font-medium leading-none tracking-[-0.04em] text-ink">
      <span data-lang="es">Tecnologías</span>
      <span data-lang="en">Technologies</span>
    </h2>
    <span class="ml-auto font-mono text-[11px] tracking-[0.2em] text-ink-4">23</span>
  </div>

  <div class="space-y-10">
    {
      technologyGroups.map((group) => (
        <div data-reveal>
          <div class="mb-4 flex items-center gap-3">
            <h3 class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-3">
              <span data-lang="es">{group.title.es}</span>
              <span data-lang="en">{group.title.en}</span>
            </h3>
            <span class="h-px flex-1 bg-hairline"></span>
            <span class="font-mono text-[11px] tracking-[0.2em] text-ink-4">
              {String(group.tools.length).padStart(2, "0")}
            </span>
          </div>

          <div class="technology-grid">
            {
              group.tools.map((tool) => {
                const Icon = techIcons[tool.icon];

                return (
                  <div class="technology-cell">
                    <Icon class="technology-icon" />
                    <span class="font-mono text-[11.5px] text-ink-2">{tool.name}</span>
                  </div>
                );
              })
            }
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .technology-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1px;
    background: rgb(255 255 255 / 0.09);
  }

  .technology-cell {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 62px;
    padding: 20px 16px;
    background: #060612;
    transition: background 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.technology-icon) {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .technology-cell:hover {
    background: rgb(255 255 255 / 0.045);
  }

  .technology-cell:hover :global(.technology-icon) {
    transform: scale(1.18) translateY(-1px);
  }
</style>
