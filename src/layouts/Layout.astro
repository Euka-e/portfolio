---
import "@fontsource/geist/400.css";
import "@fontsource/geist/500.css";
import "@fontsource/geist/600.css";
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
import profile from "../assets/profile-recent.jpg";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const profileImage = new URL(profile.src, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Eric David Diaz" />
    <meta name="theme-color" content="#060612" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eric David Diaz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:locale:alternate" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Eric David Diaz",
        url: "https://ericdiazportfolio.vercel.app",
        image: profileImage,
        jobTitle: "Full-Stack Software Engineer",
        worksFor: { "@type": "Organization", name: "Bixlabs" },
        address: { "@type": "PostalAddress", addressCountry: "AR" },
        email: "mailto:ericdiazeuka@gmail.com",
        knowsLanguage: ["es", "en"],
        sameAs: [
          "https://www.linkedin.com/in/eric-diaz-euka/",
          "https://github.com/Euka-e",
        ],
        knowsAbout: [
          "React",
          "Next.js",
          "TypeScript",
          "Node.js",
          "NestJS",
          "Astro",
          "AWS",
          "Docker",
          "AI-assisted development",
        ],
      })}
    />

    <script is:inline>
      try {
        const savedLanguage = localStorage.getItem("portfolio-language") || "es";
        document.documentElement.dataset.language = savedLanguage;
        document.documentElement.lang = savedLanguage;
      } catch {
        document.documentElement.dataset.language = "es";
        document.documentElement.lang = "es";
      }
    </script>

    <title>{title}</title>
  </head>
  <body>
    <div class="grid-overlay" aria-hidden="true">
      <div class="grid-overlay__columns">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <slot />
    <script>
      import "../scripts";
    </script>
  </body>
</html>

<style is:global>
  :root {
    --grid-line: rgba(255, 255, 255, 0.045);
    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
  }

  ::selection {
    background: #22d3ee;
    color: #060612;
  }

  html {
    font-family: "Geist", ui-sans-serif, system-ui, sans-serif;
    scroll-behavior: smooth;
    scrollbar-color: #2c2c48 #0a0a18;
    scrollbar-width: thin;
  }

  html::-webkit-scrollbar {
    width: 11px;
    background: #0a0a18;
  }

  html::-webkit-scrollbar-track {
    background: #0a0a18;
    border-left: 1px solid rgba(255, 255, 255, 0.07);
  }

  html::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, #8b5cf6, #06b6d4);
    border: 3px solid #0a0a18;
  }

  html::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, #a78bfa, #22d3ee);
  }

  html[data-language="en"] [data-lang="es"] {
    display: none !important;
  }

  html[data-language="es"] [data-lang="en"] {
    display: none !important;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;
    background: #060612;
    color: #f8fafc;
    font-family: "Geist", ui-sans-serif, system-ui, sans-serif;
  }

  main {
    position: relative;
    z-index: 1;
    width: 100%;
    transition: opacity 0.3s ease;
  }

  html[data-switching] main {
    opacity: 0.25;
    transition: opacity 0.16s ease;
  }

  body:has(#menu-toggle:checked) {
    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;
  }

  .grid-overlay {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .grid-overlay__columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: min(100%, 1280px);
    padding-inline: 24px;
  }

  .grid-overlay__columns span {
    border-left: 1px solid var(--grid-line);
  }

  .grid-overlay__columns span:last-child {
    border-right: 1px solid var(--grid-line);
  }

  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #8b5cf6, #22d3ee);
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 0.84, 0.24, 1),
      transform 0.7s cubic-bezier(0.16, 0.84, 0.24, 1),
      clip-path 0.9s cubic-bezier(0.16, 0.84, 0.24, 1);
    transition-delay: var(--d, 0ms);
  }

  [data-reveal="mask"] {
    transform: none;
    clip-path: inset(0 100% 0 0);
  }

  [data-reveal].is-in {
    opacity: 1;
    transform: none;
  }

  [data-reveal="mask"].is-in {
    clip-path: inset(0 0 0 0);
  }

  [data-rail] {
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.1s cubic-bezier(0.16, 0.84, 0.24, 1);
  }

  [data-rail].is-in {
    transform: scaleY(1);
  }

  [data-hero] {
    animation: riseIn 0.9s cubic-bezier(0.16, 0.84, 0.24, 1) both;
  }

  @keyframes riseIn {
    from {
      opacity: 0;
      transform: translateY(26px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  @keyframes toastIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    [data-reveal],
    [data-hero],
    [data-rail] {
      animation: none !important;
      clip-path: none !important;
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
